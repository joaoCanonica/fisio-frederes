---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import Consentimento from '../components/Consentimento.astro';
import { EM_PRODUCAO } from '../lib/modo.ts';
import { listarPendencias } from '../lib/pendencias.ts';
import { identificacao } from '../lib/contato.ts';

interface Props { titulo: string; descricao: string }
const { titulo, descricao } = Astro.props;
const pend = EM_PRODUCAO ? [] : listarPendencias();
const nBloq = pend.filter((p) => p.nivel === 'bloqueante').length;
const canonico = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="author" content={identificacao()} />
    <meta name="theme-color" content="#3d0f1b" />
    {EM_PRODUCAO ? <link rel="canonical" href={canonico} /> : <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    {!EM_PRODUCAO && (
      <a class="faixa-preview" href="/pendencias">
        Preview · {nBloq} pendência(s) bloqueante(s) para produção · ver lista
      </a>
    )}
    <Cabecalho />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Rodape />
    <Consentimento />
    <script>
      import '../scripts/revelar.ts';
    </script>
  </body>
</html>

<style is:global>
  .faixa-preview {
    display: block;
    padding: 0.45rem var(--gutter);
    background: #fff4d6;
    color: #5a3b00;
    font: 700 0.75rem/1.4 var(--sans);
    letter-spacing: 0.06em;
    text-align: center;
    text-decoration: none;
    border-bottom: 1px dashed #8a5a00;
  }
  main:focus { outline: none; }
</style>
