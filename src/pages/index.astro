---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Sobre from '../components/Sobre.astro';
import Desenvolvimento from '../components/Desenvolvimento.astro';
import Atua from '../components/Atua.astro';
import Onde from '../components/Onde.astro';
import Faq from '../components/Faq.astro';
import Atendimento from '../components/Atendimento.astro';
import SlotVideo from '../components/SlotVideo.astro';
import Contato from '../components/Contato.astro';
import { profile, registroCrefito, sede } from '../config/profile.config.ts';
import { slots } from '../config/slots-video.config.ts';
import { renderCompilado, renderConvite } from '../lib/slots.ts';
import { poseDaSecao, SIZES_HERO } from '../lib/retrato.ts';
import { EM_PRODUCAO } from '../lib/modo.ts';
const p = profile;
const poseHero = poseDaSecao('inicio');
const preload = poseHero ? { srcset: poseHero.avif, sizes: SIZES_HERO, type: 'image/avif' } : undefined;
const titulo = `${p.nomeMarca.valor} · Fisioterapia pediátrica em Lages (SC)`;
const descricao =
  'João Pedro Frederes, fisioterapeuta (CREFITO 369113-F): atendimento neuropediátrico com foco no desenvolvimento motor de bebês e crianças, em Lages (SC). Contato pelo WhatsApp.';
// Dados estruturados só em produção (com dados confirmados).
const ld = EM_PRODUCAO
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Physiotherapy',
      name: `${p.nomeCompleto.valor} – ${p.profissao.valor}`,
      url: p.dominio.valor,
      address: sede().endereco.valor,
      medicalSpecialty: 'Pediatric',
      employee: {
        '@type': 'Person',
        name: p.nomeCompleto.valor,
        jobTitle: p.profissao.valor,
        identifier: registroCrefito(),
      },
    })
  : null;
---
<Base titulo={titulo} descricao={descricao} landing preload={preload}>
  {ld && <script type="application/ld+json" set:html={ld} />}
  <Hero />
  <Sobre />
  <SlotVideo id="convite" render={renderConvite()} eyebrow="Apresentação" titulo={slots.conviteVideo.titulo} formato="vertical" />
  <Atua />
  <Atendimento />
  <SlotVideo
    id="videos"
    render={renderCompilado()}
    eyebrow="No atendimento"
    titulo={slots.compilado.titulo}
    texto="Registros publicados com autorização por escrito do responsável legal, que pode ser retirada a qualquer momento."
    formato="paisagem"
  />
  <Desenvolvimento />
  <Onde />
  <Faq />
  <Contato />
</Base>
