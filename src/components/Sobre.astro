---
import Provisorio from './Provisorio.astro';
import Icone from './ui/Icon.astro';
import { profile, tituloProfissional } from '../config/profile.config.ts';
import { exibir, provisorio } from '../lib/modo.ts';
import { instagramUrl } from '../lib/contato.ts';
import Pose from './Pose.astro';
import { poseDaSecao } from '../lib/retrato.ts';
const p = profile;
const { graduacao, posGraduacao, mestrado } = p.titulos;
const mest = exibir(mestrado);
const formacao = [
  { titulo: `Graduação em ${graduacao.valor.curso}`, inst: graduacao.valor.instituicao, prov: false },
  { titulo: `Pós-graduação em ${posGraduacao.valor.area}`, inst: posGraduacao.valor.instituicao, prov: false },
  ...(mest && mest.concluido
    ? [{ titulo: `Mestrado em ${mest.programa}`, inst: mest.instituicao, prov: provisorio(mestrado) }]
    : []),
];
const lattes = exibir(p.lattes);
const pose = poseDaSecao('sobre');
---
<section id="sobre" class="sec sobre" aria-labelledby="sobre-titulo">
  <div class="wrap sobre__grade">
    <div class="sobre__intro" data-revelar>
      {pose && <div class="sobre__pose"><Pose pose={pose} sizes="(min-width: 60rem) 18rem, 70vw" /></div>}
      <p class="eyebrow">Quem atende</p>
      <h2 id="sobre-titulo" class="titulo">{p.nomeMarca.valor}</h2>
      <p class="lead">
        {p.profissao.valor}. {tituloProfissional()}. Atende bebês e crianças em
        {' '}{p.regioesAtendimento.join(', ')}, com foco em neuropediatria, desenvolvimento
        motor e aspectos motores do transtorno do espectro autista (TEA).
      </p>
      {lattes && (
        <a class="btn btn--linha sobre__lattes" href={lattes} target="_blank" rel="noopener">
          Currículo Lattes <Icone nome="externo" /><span class="sr-only"> (abre em nova aba)</span>
        </a>
      )}
    </div>

    <div class="sobre__fatos">
      <h3 class="sobre__h3">Formação</h3>
      <ol class="linha-tempo">
        {formacao.map((f, i) => (
          <li data-revelar style={`--i:${i}`}>
            <strong>{f.titulo}<Provisorio ativo={f.prov} titulo="Conclusão do mestrado a confirmar" /></strong>
            {f.inst && <span>{f.inst}</span>}
          </li>
        ))}
      </ol>

      <h3 class="sobre__h3">Onde atua</h3>
      <ul class="vinculos" data-revelar>
        {p.vinculos.map((v) => (
          <li>
            <strong>{v.nome}</strong>
            <Provisorio ativo={!v.comprovante} titulo="Comprovante da autorização a arquivar" />
            <a href={instagramUrl(v.instagram)} target="_blank" rel="noopener">@{v.instagram}<span class="sr-only"> (Instagram, abre em nova aba)</span></a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .sobre { background: var(--superficie); border-block: 1px solid var(--linha); }
  .sobre__grade { display: grid; gap: 3.5rem; }
  @media (min-width: 60rem) {
    .sobre__grade { grid-template-columns: 1fr 1fr; gap: 6rem; }
    .sobre__intro { position: sticky; top: 7rem; align-self: start; }
  }
  .sobre__lattes { margin-top: 2rem; }
  .sobre__pose { width: min(70%, 18rem); margin-bottom: 2rem; }
  .sobre__h3 {
    font: 700 0.75rem/1 var(--fonte-texto);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-suave);
    margin-bottom: 1.25rem;
  }
  .sobre__h3:not(:first-child) { margin-top: 3rem; }
  .linha-tempo {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.75rem;
    border-left: 1px solid var(--linha);
    display: grid;
    gap: 1.75rem;
  }
  .linha-tempo li { position: relative; display: grid; gap: 0.2rem; }
  .linha-tempo li::before {
    content: '';
    position: absolute;
    left: calc(-1.75rem - 5px);
    top: 0.55rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--superficie);
    border: 2px solid var(--destaque);
  }
  .linha-tempo strong { font: 400 1.25rem/1.3 var(--fonte-display); }
  .linha-tempo span { color: var(--texto-suave); font-size: 0.95rem; }
  .vinculos { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
  .vinculos li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; font-size: 1.05rem; }
  .vinculos a { font-size: 0.9rem; }
</style>
