---
import Provisorio from './Provisorio.astro';
import Fontes from './ui/Fontes.astro';
import { copy } from '../config/copy.config.ts';
import { exibir, provisorio } from '../lib/modo.ts';
const c = copy.atendimento;
const duracao = exibir(c.duracaoFrequencia);
---
<section id="atendimento" class="sec" aria-labelledby="atend-titulo">
  <div class="wrap">
    <div class="atend__topo" data-revelar>
      <h2 id="atend-titulo" class="titulo">{c.titulo}</h2>
      <p class="lead">{c.intro}</p>
    </div>
    <ol class="etapas">
      {c.etapas.map((e, i) => (
        <li data-revelar style={`--i:${i}`}>
          <span class="etapas__num" aria-hidden="true">{i + 1}</span>
          <div>
            <h3>{e.titulo}</h3>
            <p>{e.texto}</p>
            {i === 2 && duracao && (
              <p class="etapas__extra">{duracao}<Provisorio ativo={provisorio(c.duracaoFrequencia)} titulo="Duração e frequência a confirmar" /></p>
            )}
          </div>
        </li>
      ))}
    </ol>
    <div class="atend__rodape" data-revelar>
      <p>{c.nota}</p>
      <Fontes fontes={c.fontes} />
    </div>
  </div>
</section>

<style>
  .atend__topo { max-width: 40rem; }
  .etapas { list-style: none; margin: 3rem 0 0; padding: 0; display: grid; gap: 2.25rem 3rem; }
  @media (min-width: 52rem) { .etapas { grid-template-columns: 1fr 1fr; } }
  .etapas li { display: grid; grid-template-columns: 3rem 1fr; gap: 1.25rem; align-items: start; }
  .etapas__num { font: 400 2.6rem/1 var(--fonte-display); color: var(--destaque); }
  .etapas h3 { font-size: 1.25rem; }
  .etapas__n { color: var(--destaque); }
  .etapas p { color: var(--texto-suave); margin-top: 0.4rem; }
  .etapas__extra { font-weight: 700; }
  .atend__rodape { margin-top: 3rem; max-width: 44rem; color: var(--texto-suave); }
</style>
