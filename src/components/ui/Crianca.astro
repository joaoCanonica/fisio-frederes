---
// Figura de criança em uma pose de marco motor. Desenho próprio e simples:
// tronco colorido (camiseta), braços e pernas no vinho da marca, cabeça grande
// com tufinho de cabelo. Poses: de bruços, sentada, engatinhando, em pé com
// apoio, andando, pulando.
export type Pose = 'deitada' | 'sentada' | 'engatinhando' | 'empe' | 'andando' | 'pulando';
interface Props { pose: Pose; cor?: string | undefined; class?: string; titulo?: string }
const { pose, cor = 'var(--ilustra-rose)', class: cls, titulo } = Astro.props;

type Fig = { tronco: string; membros: string; cabeca: [number, number]; extra?: string };
const F: Record<Pose, Fig> = {
  deitada: { tronco: 'M38 74 L66 78', membros: 'M66 78 L84 82 M66 78 L82 76 M40 76 L36 86 M46 77 L44 86', cabeca: [26, 68] },
  sentada: { tronco: 'M46 48 L46 68', membros: 'M46 70 L64 72 L72 72 M46 70 L60 76 L68 80 M46 54 L58 64 M46 54 L36 64', cabeca: [46, 34] },
  engatinhando: { tronco: 'M36 58 L62 60', membros: 'M38 60 L36 82 M44 60 L46 82 M62 62 L66 82 L78 82 M60 62 L72 76 L82 78', cabeca: [26, 50] },
  empe: { tronco: 'M38 36 L38 58', membros: 'M38 60 L34 84 M40 60 L44 84 M38 42 L58 48 M38 42 L56 52', cabeca: [38, 22], extra: 'M56 48 H84 M60 48 V86 M80 48 V86' },
  andando: { tronco: 'M48 36 L46 58', membros: 'M46 60 L36 84 M46 60 L58 82 M48 42 L36 54 M48 42 L60 50', cabeca: [49, 22] },
  pulando: { tronco: 'M50 30 L50 52', membros: 'M49 54 L40 64 L46 72 M51 54 L60 64 L54 72 M50 36 L36 22 M50 36 L64 22', cabeca: [50, 16] },
};
const f = F[pose];
const [cx, cy] = f.cabeca;
---
<svg
  class:list={['crianca', cls]}
  viewBox="0 0 100 100"
  role={titulo ? 'img' : undefined}
  aria-label={titulo}
  aria-hidden={titulo ? undefined : 'true'}
  focusable="false"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <ellipse cx="54" cy="91" rx="34" ry="3" fill="var(--ilustra-salvia)" opacity="0.5" />
  {f.extra && <path d={f.extra} stroke="var(--texto-suave)" stroke-width="3.5" opacity="0.7" />}
  <path d={f.membros} stroke="var(--destaque)" stroke-width="5.5" />
  <path d={f.tronco} stroke={cor} stroke-width="15" />
  <path d={f.tronco} stroke="var(--destaque)" stroke-width="2" opacity="0.25" />
  <circle cx={cx} cy={cy} r="10.5" fill="var(--superficie)" stroke="var(--destaque)" stroke-width="3" />
  <path d={`M${cx - 6} ${cy - 8} q6 -7 12 -1`} stroke="var(--destaque)" stroke-width="3.5" />
  <circle cx={cx + 3} cy={cy + 1} r="1.4" fill="var(--destaque)" />
</svg>

<style>
  .crianca { display: block; width: 100%; height: auto; overflow: visible; }
</style>
