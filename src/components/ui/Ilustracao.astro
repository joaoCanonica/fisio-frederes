---
// Ilustrações próprias, de traço único, para o universo do desenvolvimento
// infantil: pegadas, blocos de montar, bola, escada, mão e chocalho, além do
// "caminho" (pegadas que atravessam a seção). Traço na cor da marca e preenchimentos
// suaves (tokens --ilustra-*). Sempre decorativas: aria-hidden.
interface Props {
  nome: 'pegadas' | 'blocos' | 'bola' | 'escada' | 'mao' | 'chocalho' | 'caminho' | 'cubo';
  class?: string;
}
const { nome, class: cls } = Astro.props;
const T = 'var(--destaque)';
---
{nome === 'caminho' ? (
  <svg class:list={['ilu', 'ilu--caminho', cls]} viewBox="0 0 600 60" aria-hidden="true" focusable="false">
    {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => {
      const x = 30 + i * 74;
      const y = i % 2 === 0 ? 20 : 38;
      return (
        <g transform={`translate(${x} ${y}) rotate(90)`} fill="var(--ilustra-rose)" stroke={T} stroke-width="1.6" style={`--i:${i}`} class="ilu__passo">
          <path d="M0 -9c4 0 6 4 6 9s-2 9-6 9-6-4-6-9 2-9 6-9z" />
          <circle cx="-4" cy="-13" r="1.6" /><circle cx="0" cy="-14.5" r="1.8" /><circle cx="4" cy="-13" r="1.6" />
        </g>
      );
    })}
  </svg>
) : (
  <svg class:list={['ilu', cls]} viewBox="0 0 96 96" aria-hidden="true" focusable="false" fill="none" stroke={T} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    {nome === 'pegadas' && (
      <>
        <path d="M34 30c7 0 10 7 10 15s-3 16-10 16-10-8-10-16 3-15 10-15z" fill="var(--ilustra-rose)" />
        <circle cx="27" cy="22" r="2.6" fill="var(--ilustra-rose)" /><circle cx="33" cy="19" r="3" fill="var(--ilustra-rose)" /><circle cx="40" cy="21" r="2.6" fill="var(--ilustra-rose)" />
        <path d="M62 44c7 0 10 7 10 15s-3 16-10 16-10-8-10-16 3-15 10-15z" fill="var(--ilustra-salvia)" />
        <circle cx="55" cy="36" r="2.6" fill="var(--ilustra-salvia)" /><circle cx="61" cy="33" r="3" fill="var(--ilustra-salvia)" /><circle cx="68" cy="35" r="2.6" fill="var(--ilustra-salvia)" />
      </>
    )}
    {nome === 'blocos' && (
      <>
        <rect x="18" y="52" width="26" height="26" rx="4" fill="var(--ilustra-ceu)" />
        <rect x="50" y="52" width="26" height="26" rx="4" fill="var(--ilustra-sol)" />
        <rect x="34" y="24" width="26" height="26" rx="4" fill="var(--ilustra-rose)" transform="rotate(-8 47 37)" />
        <path d="M27 65h8M63 60v12M41 33l8 6" />
      </>
    )}
    {nome === 'bola' && (
      <>
        <circle cx="48" cy="46" r="26" fill="var(--ilustra-sol)" />
        <path d="M22 46c10-6 42-6 52 0M48 20c-8 9-8 43 0 52M30 28c6 6 30 30 36 36" />
        <path d="M30 84h36" stroke-width="2" opacity="0.5" />
      </>
    )}
    {nome === 'escada' && (
      <>
        <path d="M14 80h20V62h20V44h20V26h10" fill="none" />
        <path d="M14 80h20V62h20V44h20V26h10V80z" fill="var(--ilustra-salvia)" stroke="none" opacity="0.6" />
        <circle cx="44" cy="44" r="5" fill="var(--ilustra-rose)" />
        <path d="M44 49v8M40 53h8M44 57l-4 6M44 57l4 6" />
      </>
    )}
    {nome === 'mao' && (
      <>
        <path d="M32 78V44c0-4 6-4 6 0v16V30c0-4 6-4 6 0v28V26c0-4 6-4 6 0v32V32c0-4 6-4 6 0v32c6-6 12-8 14-4 1 3-10 14-14 20-4 5-9 8-16 8-5 0-8-4-8-10z" fill="var(--ilustra-rose)" />
      </>
    )}
    {nome === 'chocalho' && (
      <>
        <circle cx="40" cy="38" r="20" fill="var(--ilustra-ceu)" />
        <path d="M54 52l20 20" stroke-width="7" />
        <path d="M54 52l20 20" stroke="var(--ilustra-sol)" stroke-width="3" />
        <circle cx="34" cy="34" r="3" fill="var(--superficie)" /><circle cx="46" cy="42" r="3" fill="var(--superficie)" />
      </>
    )}
    {nome === 'cubo' && (
      <>
        <path d="M48 16l30 15v34L48 80 18 65V31z" fill="var(--ilustra-sol)" />
        <path d="M18 31l30 15 30-15M48 46v34" />
        <path d="M30 44l8 4M58 50l8-4M44 60h8" />
      </>
    )}
  </svg>
)}

<style>
  .ilu { display: block; width: 100%; height: auto; overflow: visible; }
  .ilu--caminho .ilu__passo { opacity: 0.85; }
  :global(.js) .ilu--caminho .ilu__passo { opacity: 0; animation: passo 0.5s ease forwards; animation-delay: calc(var(--i) * 0.12s); animation-play-state: paused; }
  :global(.visivel) .ilu--caminho .ilu__passo,
  :global(.visivel).ilu--caminho .ilu__passo { animation-play-state: running; }
  @keyframes passo { to { opacity: 0.85; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .ilu--caminho .ilu__passo { opacity: 0.85; animation: none; }
  }
</style>
