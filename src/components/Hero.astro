---
// Primeira dobra: deixa claro em 2 s que é fisioterapia PEDIÁTRICA e já mostra a
// identificação (nome completo, profissão, CREFITO). O lúdico vem da foto.
// A foto vem das poses do retrato (src/config/retrato.config.ts).
import Formas from './ui/Formas.astro';
import Button from './ui/Button.astro';
import BadgeId from './ui/BadgeId.astro';
import MediaFrame from './ui/MediaFrame.astro';
import Pose from './Pose.astro';
import Marca from './Marca.astro';
import Provisorio from './Provisorio.astro';
import { copy } from '../config/copy.config.ts';
import { whatsappUrl, instagramUrl } from '../lib/contato.ts';
import { poseDaSecao, SIZES_HERO } from '../lib/retrato.ts';
import { provisorio } from '../lib/modo.ts';

const pose = poseDaSecao('inicio');
---
<section id="inicio" class="hero tom-claro com-formas" aria-labelledby="hero-titulo">
  <Formas variante="a" />
  <div class="wrap hero__grade">
    <div class="hero__texto">
      <p class="hero__local">Fisioterapia pediátrica em Lages (SC)</p>
      <h1 id="hero-titulo" class="hero__h1">
        {copy.hero.titulo.valor}<Provisorio ativo={provisorio(copy.hero.titulo)} titulo="Título proposto: confirmar" />
      </h1>
      <p class="lead hero__sub">{copy.hero.subtitulo.valor}</p>
      <div class="hero__acoes">
        <Button href={whatsappUrl()} externo>Chamar no WhatsApp</Button>
        <Button href={instagramUrl()} variante="secundario" externo>Ver o Instagram</Button>
      </div>
      <div class="hero__id"><BadgeId compacto /></div>
    </div>

    <div class="hero__visual">
      {pose ? (
        <Pose pose={pose} sizes={SIZES_HERO} prioridade />
      ) : (
        <MediaFrame formato="4:5" arco>
          <div class="hero__semfoto" role="img" aria-label="Monograma JF"><Marca class="hero__marca" /></div>
        </MediaFrame>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 5vw, 4.5rem) var(--sec);
    overflow: clip;
    /* Suave: roseNevoa → branco no claro; grafite levemente mais claro → fundo no escuro. */
    background: linear-gradient(180deg, var(--hero-topo) 0%, var(--fundo) 85%);
  }
  .hero__grade { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 60rem) {
    .hero__grade { grid-template-columns: 1.2fr 1fr; gap: 4.5rem; }
  }
  .hero__h1 {
    font-size: clamp(1.9rem, 1.1rem + 3vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: 0.03em;
    margin-top: 1.25rem;
  }
  .hero__sub { margin-top: 1.1rem; }
  .hero__id { margin-top: 1.75rem; }
  .hero__local { font-weight: 700; color: var(--destaque); font-size: 0.95rem; }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .hero__visual { position: relative; justify-self: center; width: min(100%, 28rem); }
  /* Arco do retrato com contorno vinho (vinhoClaro no escuro, via --arco). */
  .hero__visual :global(.mf__midia) { border: 3px solid var(--arco); outline: 6px solid var(--superficie); outline-offset: 0; }
  .hero__semfoto { height: 100%; display: grid; place-items: center; }
  .hero__visual :global(.hero__marca) { width: 45%; height: auto; color: var(--marca); }

  /* Mobile (até 60rem): retrato primeiro, no máximo 40svh, e o CTA do WhatsApp
     ainda visível sem rolar (o título sozinho já diz "crianças"). */
  @media (max-width: 59.99rem) {
    .hero { padding-top: 1rem; }
    .hero__grade { gap: 1.25rem; }
    .hero__visual { order: -1; width: min(78%, calc(40svh * 0.8)); }
    .hero__h1 { font-size: clamp(1.6rem, 1.2rem + 2.2vw, 2.4rem); margin-top: 0.5rem; }
    .hero__sub { margin-top: 0.6rem; font-size: 1rem; }
    .hero__acoes { margin-top: 1rem; }
    .hero__id { margin-top: 1rem; }
  }
</style>
