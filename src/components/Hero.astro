---
import Icone from './Icone.astro';
import Identificacao from './Identificacao.astro';
import { whatsappUrl, instagramUrl } from '../lib/contato.ts';
---
<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero__fundo" aria-hidden="true"></div>
  <div class="wrap hero__grade">
    <div class="hero__texto">
      <p class="eyebrow">Fisioterapia neuropediátrica</p>
      <h1 id="hero-titulo" class="hero__h1">
        É pelo movimento que a criança <em>descobre</em> o mundo.
      </h1>
      <p class="lead">
        Atendimento fisioterapêutico para bebês e crianças, com foco no desenvolvimento
        motor, na coordenação e no equilíbrio, incluindo crianças no espectro autista.
      </p>
      <div class="hero__acoes">
        <a class="btn" href={whatsappUrl()} target="_blank" rel="noopener">
          <Icone nome="whatsapp" /> Conversar pelo WhatsApp<span class="sr-only"> (abre em nova aba)</span>
        </a>
        <a class="btn btn--linha" href={instagramUrl()} target="_blank" rel="noopener">
          <Icone nome="instagram" /> Instagram<span class="sr-only"> (abre em nova aba)</span>
        </a>
      </div>
    </div>

    <figure class="hero__trajeto" aria-labelledby="trajeto-legenda">
      <svg viewBox="0 0 440 440" role="img" aria-labelledby="trajeto-legenda">
        <defs>
          <linearGradient id="g-trajeto" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="var(--vinho-300)" />
            <stop offset="1" stop-color="var(--vinho-700)" />
          </linearGradient>
        </defs>
        <circle cx="220" cy="220" r="200" fill="var(--gelo-0)" />
        <circle cx="220" cy="220" r="200" fill="none" stroke="var(--linha)" />
        <circle cx="220" cy="220" r="150" fill="none" stroke="var(--linha)" stroke-dasharray="2 6" />
        <path class="hero__linha" pathLength="1"
          d="M70 330 C 120 330, 130 290, 160 280 S 200 230, 230 220 S 270 160, 300 140 S 350 100, 372 92"
          fill="none" stroke="url(#g-trajeto)" stroke-width="3" stroke-linecap="round" />
        {[
          [70, 330, 'deitar'],
          [160, 280, 'sentar'],
          [230, 220, 'ficar em pé'],
          [300, 140, 'andar'],
          [372, 92, 'explorar'],
        ].map(([x, y, rotulo], i) => (
          <g class="hero__marco" style={`--i:${i}`}>
            <circle cx={x} cy={y} r="7" fill="var(--gelo-50)" stroke="var(--vinho-700)" stroke-width="2" />
            <text x={Number(x) + 14} y={Number(y) + 22} font-size="13" fill="var(--suave)" font-family="Manrope Variable, sans-serif">{rotulo}</text>
          </g>
        ))}
      </svg>
      <figcaption id="trajeto-legenda" class="sr-only">
        Ilustração: uma linha que sobe passando por deitar, sentar, ficar em pé, andar e explorar,
        representando o desenvolvimento motor.
      </figcaption>
      <div class="hero__cartao">
        <Identificacao />
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6.5rem) var(--sec);
    overflow: clip;
  }
  .hero__fundo {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vmax;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, var(--rosa-100), transparent 70%);
    opacity: 0.8;
    pointer-events: none;
  }
  .hero__grade {
    position: relative;
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }
  @media (min-width: 60rem) {
    .hero__grade { grid-template-columns: 1.15fr 1fr; }
  }
  .hero__h1 {
    font-size: clamp(2.6rem, 1.4rem + 5.2vw, 5.4rem);
    font-weight: 330;
    letter-spacing: -0.03em;
    margin-top: 1.25rem;
  }
  .hero__h1 em {
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    color: var(--vinho-700);
  }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }

  .hero__trajeto { position: relative; margin: 0; max-width: 32rem; justify-self: center; width: 100%; }
  .hero__linha {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: desenhar 2.4s 0.3s var(--ease) forwards;
  }
  .hero__marco {
    opacity: 0;
    animation: surgir 0.6s var(--ease) forwards;
    animation-delay: calc(0.5s + var(--i) * 0.42s);
  }
  @keyframes desenhar { to { stroke-dashoffset: 0; } }
  @keyframes surgir { to { opacity: 1; } }

  .hero__cartao {
    position: relative;
    margin: -3rem 0 0 auto;
    width: min(100%, 22rem);
    background: color-mix(in oklab, var(--gelo-0) 92%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    padding: 1.4rem 1.5rem;
    box-shadow: 0 30px 60px -30px rgb(61 15 27 / 0.35);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__linha { stroke-dashoffset: 0; animation: none; }
    .hero__marco { opacity: 1; animation: none; }
  }
</style>
