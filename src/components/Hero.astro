---
// Primeira dobra: deixa claro em 2 s que é fisioterapia PEDIÁTRICA e já mostra a
// identificação (nome completo, profissão, CREFITO). O lúdico vem da foto.
// A foto vem das poses do retrato (src/config/retrato.config.ts).
import Button from './ui/Button.astro';
import Eyebrow from './ui/Eyebrow.astro';
import BadgeId from './ui/BadgeId.astro';
import Tag from './ui/Tag.astro';
import MediaFrame from './ui/MediaFrame.astro';
import Pose from './Pose.astro';
import Marca from './Marca.astro';
import Provisorio from './Provisorio.astro';
import Ilustracao from './ui/Ilustracao.astro';
import { profile } from '../config/profile.config.ts';
import { copy } from '../config/copy.config.ts';
import { whatsappUrl, instagramUrl } from '../lib/contato.ts';
import { poseDaSecao, SIZES_HERO } from '../lib/retrato.ts';
import { provisorio } from '../lib/modo.ts';

const pose = poseDaSecao('inicio');
const publicos = ['Bebês', 'Crianças', 'Crianças no espectro autista (TEA)'];
---
<section id="inicio" class="hero tom-claro" aria-labelledby="hero-titulo">
  <div class="wrap hero__grade">
    <div class="hero__texto">
      <Eyebrow>Fisioterapia pediátrica · Lages (SC)</Eyebrow>
      <h1 id="hero-titulo" class="hero__h1">
        {copy.hero.titulo.valor}<Provisorio ativo={provisorio(copy.hero.titulo)} titulo="Título proposto: confirmar" />
      </h1>
      <p class="lead hero__sub">{copy.hero.subtitulo.valor}</p>
      <div class="hero__id"><BadgeId /></div>
      <ul class="hero__publicos" aria-label="Para quem é o atendimento">
        {publicos.map((p, i) => <li><Tag variante={i === 0 ? 'acento' : 'neutra'}>{p}</Tag></li>)}
      </ul>
      <div class="hero__acoes">
        <Button href={whatsappUrl()} icone="whatsapp" externo>Conversar pelo WhatsApp</Button>
        <Button href={instagramUrl()} icone="instagram" variante="secundario" externo>@{profile.instagram.valor}</Button>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__ilu hero__ilu--blocos" aria-hidden="true"><Ilustracao nome="blocos" /></div>
      <div class="hero__ilu hero__ilu--bola" aria-hidden="true"><Ilustracao nome="bola" /></div>
      {pose ? (
        <Pose pose={pose} sizes={SIZES_HERO} prioridade />
      ) : (
        <MediaFrame formato="4:5" arco>
          <div class="hero__semfoto" role="img" aria-label="Monograma JF"><Marca class="hero__marca" /></div>
        </MediaFrame>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 5vw, 4.5rem) var(--sec);
    overflow: clip;
    background:
      radial-gradient(46rem 34rem at 100% 0%, var(--superficie-alt), transparent 65%),
      var(--fundo);
  }
  .hero__grade { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 60rem) {
    .hero__grade { grid-template-columns: 1.2fr 1fr; gap: 4.5rem; }
  }
  .hero__h1 {
    font-size: clamp(1.9rem, 1.1rem + 3vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: 0.03em;
    margin-top: 1.25rem;
  }
  .hero__sub { margin-top: 1.1rem; }
  .hero__id { margin-top: 1.4rem; }
  .hero__publicos { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0 0; padding: 0; }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .hero__visual { position: relative; justify-self: center; width: min(100%, 28rem); }
  .hero__ilu { position: absolute; z-index: 2; }
  .hero__ilu--blocos { width: 7rem; left: -3rem; bottom: 2.5rem; }
  .hero__ilu--bola { width: 4.5rem; right: -1.5rem; top: 10%; }
  @media (max-width: 40rem) { .hero__ilu--blocos { width: 5rem; left: -1rem; } .hero__ilu--bola { width: 3.5rem; right: -0.5rem; } }
  .hero__semfoto { height: 100%; display: grid; place-items: center; }
  .hero__visual :global(.hero__marca) { width: 45%; height: auto; color: var(--marca); }
  /* Mobile: foto antes do texto? Não: texto primeiro (o título é o que diz "pediatria"),
     foto logo abaixo, reduzida para aparecer cedo. */
  @media (max-width: 59.99rem) {
    .hero__visual { width: min(78%, 22rem); }
  }
</style>
