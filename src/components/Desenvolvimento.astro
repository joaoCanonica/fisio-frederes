---
// Fontes: docs/pesquisa/marcos-motores.md
import { FONTE_MARCOS, marcos, meses } from '../data/marcos.ts';
import Fontes from './ui/Fontes.astro';
import Crianca from './ui/Crianca.astro';
const faixa = [
  ['deitada', 'Tummy', 'var(--ilustra-rose)'],
  ['sentada', 'Sentar', 'var(--ilustra-sol)'],
  ['engatinhando', 'Engatinhar', 'var(--ilustra-salvia)'],
  ['empe', 'Ficar em pé', 'var(--ilustra-ceu)'],
  ['andando', 'Andar', 'var(--ilustra-rose)'],
  ['pulando', 'Pular', 'var(--ilustra-sol)'],
] as const;
import { copy } from '../config/copy.config.ts';
const c = copy.porque;
---
<section id="porque" class="sec tom-vinho" aria-labelledby="dev-titulo">
  <div class="wrap" data-revelar>
    <ol class="dev__faixa" aria-label="Alguns marcos do desenvolvimento motor">
      {faixa.map(([pose, rotulo, cor]) => (<li><Crianca pose={pose} cor={cor} /><span>{rotulo}</span></li>))}
    </ol>
  </div>
  <div class="wrap">
    <div class="dev__topo" data-revelar>
      <h2 id="dev-titulo" class="titulo">{c.titulo}</h2>
      <p class="lead">{c.texto}</p>
      <Fontes fontes={c.fontes} />
      <p class="dev__p dev__ritmo">{c.ritmo.texto}</p>
    </div>

    <figure class="grafico" data-revelar>
      <figcaption class="grafico__leg">Em que mês cada marco costuma aparecer</figcaption>
      <ol class="linha bolas">
        {marcos.map((m, i) => (
          <li style={`--i:${i}`}>
            <span class="linha__ponto" aria-hidden="true"></span>
            <span class="linha__mes">{meses(m)}</span>
            <span class="linha__nome">{m.nome}</span>
            {m.detalhe && <span class="linha__det">{m.detalhe}</span>}
            {m.obrigatorio && <strong class="linha__tag">obrigatório</strong>}
          </li>
        ))}
      </ol>
      <p class="fonte">Referência usada no acompanhamento: {FONTE_MARCOS.texto}. Meses de vida da criança.</p>
    </figure>

    <div class="dev__blocos">
      <div class="dev__caderneta" data-revelar>
        <h3 class="dev__h3">{c.caderneta.titulo}</h3>
        <p class="dev__p">{c.caderneta.texto}</p>
        <Fontes fontes={[c.caderneta.fonte]} />
      </div>
      <p class="dev__nota" data-revelar>{c.honestidade}</p>
    </div>
  </div>
</section>

<style>
  .dev__topo { max-width: 44rem; }
  .dev__h3 { font-size: 1.05rem; margin-top: 2.25rem; }
  .dev__p { margin-top: 0.6rem; color: var(--texto-suave); }
  .dev__ritmo { margin-top: 1.75rem; max-width: 40rem; }
  .dev__blocos { display: grid; gap: 2rem; margin-top: 3rem; }
  @media (min-width: 60rem) { .dev__blocos { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; } }
  .dev__faixa { list-style: none; margin: 0 0 3.5rem; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; max-width: 64rem; }
  .dev__faixa li { display: grid; justify-items: center; gap: 0.4rem; font-size: 0.82rem; color: var(--texto-suave); text-align: center; }
  .dev__faixa :global(.crianca) { width: min(100%, 8.5rem); }
  .dev__faixa li span { font-weight: 700; color: var(--destaque); font-size: 0.9rem; }
  @media (max-width: 34rem) { .dev__faixa { grid-template-columns: repeat(3, 1fr); row-gap: 1.25rem; } }
  .dev__caderneta { padding-left: 1.25rem; border-left: 3px solid var(--destaque); }
  .dev__caderneta .dev__h3 { margin-top: 0; }
  .grafico {
    margin: 3.5rem 0 0;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    background: var(--superficie);
    border: 1px solid var(--linha);
    border-radius: var(--raio-g);
  }
  .grafico__leg { font-weight: 600; margin-bottom: 1.75rem; }
  /* Linha do tempo: vertical no celular, horizontal a partir de 56rem. */
  .linha { list-style: none; margin: 0; padding: 0; display: grid; }
  .linha li { position: relative; display: grid; align-content: start; gap: 0.2rem; padding: 0 0 1.5rem 2.4rem; }
  .linha li::before {
    content: '';
    position: absolute;
    left: calc(0.6rem - 1px);
    top: 0.6rem;
    bottom: -0.6rem;
    width: 2px;
    background: var(--borda);
  }
  .linha li:last-child { padding-bottom: 0; }
  .linha li:last-child::before { display: none; }
  .linha__ponto {
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    background: var(--bola, var(--destaque));
    box-shadow: 0 0 0 4px var(--superficie);
  }
  .linha__mes { font: 700 1.05rem/1.25 var(--fonte-texto); color: var(--destaque); }
  .linha__nome { font-size: 1rem; line-height: 1.35; }
  .linha__det { font-size: 0.82rem; color: var(--texto-suave); }
  .linha__tag {
    justify-self: start;
    margin-top: 0.3rem;
    font: 700 0.66rem/1 var(--fonte-texto);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    background: var(--acao);
    color: var(--acao-texto);
  }
  @media (min-width: 56rem) {
    .linha { grid-template-columns: repeat(7, 1fr); gap: 0.75rem; }
    .linha li { padding: 2.25rem 0 0; }
    .linha li::before { left: 0.6rem; right: -0.75rem; top: calc(0.6rem - 1px); bottom: auto; width: auto; height: 2px; }
    .linha__ponto { top: 0; }
  }
  .js .grafico[data-revelar] .linha__ponto { transform: scale(0); transition: transform 0.5s var(--ease); transition-delay: calc(0.2s + var(--i) * 0.1s); }
  .js .grafico.visivel .linha__ponto { transform: none; }
  .fonte { margin-top: 1.5rem; font-size: 0.82rem; color: var(--texto-suave); }
  .dev__nota {
    margin-top: 0;
    max-width: 44rem;
    padding-left: 1.25rem;
    border-left: 3px solid var(--destaque);
    color: var(--texto-suave);
  }
  @media (prefers-reduced-motion: reduce) {
    .js .grafico[data-revelar] .linha__ponto { transform: none; }
  }
</style>
