---
// Para quem é o atendimento. Limite inegociável no TEA: só o que a fisioterapia faz
// (movimento e participação), nunca tratar/curar/reduzir o autismo. Fontes: docs/pesquisa/.
import Fontes from './ui/Fontes.astro';
import Crianca from './ui/Crianca.astro';
import { copy } from '../config/copy.config.ts';
const c = copy.atua;
const poses = ['andando', 'engatinhando', 'pulando'] as const;
const cores = ['var(--ilustra-salvia)', 'var(--ilustra-ceu)', 'var(--ilustra-sol)'];
---
<section id="atua" class="sec atua tom-claro" aria-labelledby="atua-titulo">
  <div class="wrap">
    <div class="atua__topo" data-revelar>
      <h2 id="atua-titulo" class="titulo">{c.titulo}</h2>
      <p class="lead">{c.intro}</p>
    </div>

    <ul class="atua__lista">
      {c.areas.map((a, i) => (
        <li data-revelar style={`--i:${i}`}>
          <div class="atua__ilu"><Crianca pose={poses[i] ?? 'andando'} cor={cores[i]} /></div>
          <h3>{a.titulo}</h3>
          <p>{a.texto}</p>
          <Fontes fontes={a.fontes} />
        </li>
      ))}
    </ul>

    <figure class="atua__dado" data-revelar>
      <p class="atua__num">{c.dado.numero}</p>
      <figcaption>
        {c.dado.texto}
        <Fontes fontes={[c.dado.fonte]} />
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .atua { background: var(--superficie-alt); }
  .atua__topo { max-width: 40rem; }
  .atua__lista { list-style: none; margin: 3.5rem 0 0; padding: 0; display: grid; gap: 3rem; }
  @media (min-width: 60rem) { .atua__lista { grid-template-columns: repeat(3, 1fr); gap: 3.5rem; } }
  .atua__ilu { width: 7.5rem; margin-bottom: 1rem; }
  .atua__lista h3 { font-size: 1.45rem; color: var(--destaque); }
  .atua__lista p { color: var(--texto-suave); margin-top: 0.6rem; }
  .atua__dado {
    margin: 4rem 0 0;
    display: grid;
    gap: 0.5rem 2rem;
    align-items: center;
    padding-top: 2.5rem;
    border-top: 1px solid var(--linha);
  }
  @media (min-width: 48rem) { .atua__dado { grid-template-columns: auto 1fr; } }
  .atua__num { font: 400 clamp(3rem, 6vw, 4.5rem)/1 var(--fonte-display); color: var(--destaque); }
  .atua__dado figcaption { color: var(--texto-suave); max-width: 38rem; }
</style>
